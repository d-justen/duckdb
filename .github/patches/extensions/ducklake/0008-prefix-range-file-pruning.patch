+			if (data.child_filter_expr) {
+				return GetPrefixRangeFunctionData(*data.child_filter_expr);
+			}
+		}
+		if (function.function.GetName() == SelectivityOptionalFilterScalarFun::NAME && function.bind_info) {
+			auto &data = function.bind_info->Cast<SelectivityOptionalFilterFunctionData>();
