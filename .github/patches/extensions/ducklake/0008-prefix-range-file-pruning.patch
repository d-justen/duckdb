diff --git a/test/sql/stats/prefix_range_filter_file_pruning.test b/test/sql/stats/prefix_range_filter_file_pruning.test
new file mode 100644
index 00000000..716e2a6a
--- /dev/null
+++ b/test/sql/stats/prefix_range_filter_file_pruning.test
@@ -0,0 +1,199 @@
+# name: test/sql/stats/prefix_range_filter_file_pruning.test
+# description: Test prefix range filters against DuckLake file-level min/max statistics
+# group: [stats]
+
+require ducklake
+
+require parquet
+
+test-env DUCKLAKE_CONNECTION {TEST_DIR}/{UUID}.db
+
+test-env DATA_PATH {TEST_DIR}
+
+statement ok
+ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake
+    (DATA_PATH '{DATA_PATH}/ducklake_prf_file_pruning', DATA_INLINING_ROW_LIMIT 0,
+     METADATA_CATALOG 'ducklake_meta')
+
+statement ok
+SET disabled_optimizers = 'join_order,build_side_probe_side,compressed_materialization'
+
+statement ok
+SET threads = 1
+
+statement ok
+SET dynamic_or_filter_threshold = 0
+
+statement ok
+SET enable_join_bloom_filter_pushdown = false
+
+statement ok
+SET enable_perfect_hash_join_filter_pushdown = false
+
+# Disable min/max pushdown explicitly: this test must prune files with the PRF itself.
+statement ok
+SET enable_join_min_max_filter_pushdown = false
+
+statement ok
+CREATE TABLE ducklake.prf_probe(k INTEGER)
+
+# Four separate files. The build keys overlap the first and third files. The second file is inside the
+# overall build-key min/max interval but covers only empty PRF buckets; the fourth is outside that interval.
+statement ok
+INSERT INTO ducklake.prf_probe SELECT i::INTEGER FROM range(0, 1000) t(i)
+
+statement ok
+INSERT INTO ducklake.prf_probe SELECT i::INTEGER FROM range(10000, 11000) t(i)
+
+statement ok
+INSERT INTO ducklake.prf_probe SELECT i::INTEGER FROM range(20000, 21000) t(i)
+
+statement ok
+INSERT INTO ducklake.prf_probe SELECT i::INTEGER FROM range(30000, 31000) t(i)
+
+statement ok
+CREATE TABLE prf_build(k INTEGER)
+
+statement ok
+INSERT INTO prf_build VALUES (100), (20100)
+
+query I
+SELECT count(*)
+FROM ducklake.prf_probe probe
+JOIN prf_build build USING (k)
+----
+2
+
+query II
+EXPLAIN ANALYZE
+SELECT count(*)
+FROM ducklake.prf_probe probe
+JOIN prf_build build USING (k)
+----
+analyzed_plan	<REGEX>:.*IN PRF\(k\).*
+
+# Both the file in an empty PRF range and the file outside the PRF domain are skipped before Parquet opens.
+query II
+EXPLAIN ANALYZE
+SELECT count(*)
+FROM ducklake.prf_probe probe
+JOIN prf_build build USING (k)
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 2.*
+
+query II
+EXPLAIN ANALYZE
+SELECT count(*)
+FROM ducklake.prf_probe probe
+JOIN prf_build build USING (k)
+----
+analyzed_plan	<REGEX>:.*Total Files Skipped:.*1.*
+
+statement ok
+SET enable_prefix_range_filter = false
+
+# The regular optimizer range excludes the fourth file, but without PRF the file in the empty bucket range is opened.
+query II
+EXPLAIN ANALYZE
+SELECT count(*)
+FROM ducklake.prf_probe probe
+JOIN prf_build build USING (k)
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 3.*
+
+statement ok
+RESET enable_prefix_range_filter
+
+# Missing statistics must retain the file. Remove the statistics for the file in the empty PRF range and verify that it
+# is opened again even though the PRF can still prune files whose statistics are available.
+statement ok
+UPDATE ducklake_meta.ducklake_file_column_stats
+SET min_value = NULL, max_value = NULL
+WHERE min_value = '10000' AND max_value = '10999'
+
+query I
+SELECT count(*)
+FROM ducklake.prf_probe probe
+JOIN prf_build build USING (k)
+----
+2
+
+query II
+EXPLAIN ANALYZE
+SELECT count(*)
+FROM ducklake.prf_probe probe
+JOIN prf_build build USING (k)
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 3.*
+
+statement ok
+UPDATE ducklake_meta.ducklake_file_column_stats
+SET min_value = '10000', max_value = '10999'
+WHERE min_value IS NULL AND max_value IS NULL
+
+statement ok
+CREATE TABLE ducklake.prf_string_probe(k VARCHAR)
+
+statement ok
+INSERT INTO ducklake.prf_string_probe SELECT printf('%06d', i) FROM range(0, 1000) t(i)
+
+statement ok
+INSERT INTO ducklake.prf_string_probe SELECT printf('%06d', i) FROM range(100000, 101000) t(i)
+
+statement ok
+INSERT INTO ducklake.prf_string_probe SELECT printf('%06d', i) FROM range(200000, 201000) t(i)
+
+statement ok
+CREATE TABLE prf_string_build(k VARCHAR)
+
+statement ok
+INSERT INTO prf_string_build VALUES ('000100'), ('200100')
+
+query I
+SELECT count(*)
+FROM ducklake.prf_string_probe probe
+JOIN prf_string_build build USING (k)
+----
+2
+
+query II
+EXPLAIN ANALYZE
+SELECT count(*)
+FROM ducklake.prf_string_probe probe
+JOIN prf_string_build build USING (k)
+----
+analyzed_plan	<REGEX>:.*IN PRF\(k\).*
+
+query II
+EXPLAIN ANALYZE
+SELECT count(*)
+FROM ducklake.prf_string_probe probe
+JOIN prf_string_build build USING (k)
+----
+analyzed_plan	<REGEX>:.*Total Files Read: 2.*
+
+query II
+EXPLAIN ANALYZE
+SELECT count(*)
+FROM ducklake.prf_string_probe probe
+JOIN prf_string_build build USING (k)
+----
+analyzed_plan	<REGEX>:.*Total Files Skipped:.*1.*
+
+statement ok
+RESET enable_join_min_max_filter_pushdown
+
+statement ok
+RESET enable_join_bloom_filter_pushdown
+
+statement ok
+RESET enable_perfect_hash_join_filter_pushdown
+
+statement ok
+RESET dynamic_or_filter_threshold
+
+statement ok
+RESET threads
+
+statement ok
+SET disabled_optimizers = ''
