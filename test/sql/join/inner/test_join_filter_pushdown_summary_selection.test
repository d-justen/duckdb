analyzed_plan	<REGEX>:.*IN PRF\(k\).*

statement ok
SET enable_join_min_max_filter_pushdown=false

statement ok
SET dynamic_or_filter_threshold=0

query II
EXPLAIN ANALYZE
SELECT count(*)
FROM probe_phj_runtime_filter p
JOIN build_phj_runtime_filter b
  ON p.k = b.k;
----
analyzed_plan	<REGEX>:.*Dynamic Filters:.*k IN PRF\(k\).*10,009 rows.*

statement ok
SET enable_prefix_range_filter=false

query II
EXPLAIN ANALYZE
SELECT count(*)
FROM probe_phj_runtime_filter p
JOIN build_phj_runtime_filter b
  ON p.k = b.k;
----
analyzed_plan	<REGEX>:.*Dynamic Filters:.*k IN BF\(k\).*

query II
EXPLAIN ANALYZE
SELECT count(*)
FROM probe_phj_runtime_filter p
JOIN build_phj_runtime_filter b
  ON p.k = b.k;
----
analyzed_plan	<!REGEX>:.*100,000 rows.*

statement ok
PRAGMA enable_profiling = 'json';

statement ok
PRAGMA profiling_output = '{TEST_DIR}/join_filter_pushdown_summary_selection_profile.json';

statement ok
SELECT count(*)
FROM probe_phj_runtime_filter p
JOIN build_phj_runtime_filter b
  ON p.k = b.k;

statement ok
PRAGMA disable_profiling;

statement ok
SET enable_join_bloom_filter_row_group_pruning=false

query II
EXPLAIN ANALYZE
SELECT count(*)
FROM probe_phj_runtime_filter p
JOIN build_phj_runtime_filter b
  ON p.k = b.k;
----
analyzed_plan	<REGEX>:.*"Dynamic Filters": "optional: k IN BF\(k\)".*

statement ok
