# name: test/sql/join/inner/test_join_filter_pushdown_precedence.test
# description: Test dynamic join filter precedence and min/max fallback behavior
# group: [inner]

statement ok
SET disabled_optimizers = 'join_order,build_side_probe_side';

statement ok
CREATE OR REPLACE TABLE precedence_probe AS
SELECT i::INTEGER AS k
FROM range(0, 100000) t(i);

statement ok
CREATE OR REPLACE TABLE precedence_build AS
SELECT i::INTEGER AS k, 'v' || i::VARCHAR AS payload
FROM range(0, 30000) t(i);

query II
EXPLAIN ANALYZE
SELECT count(*)
FROM precedence_probe p
JOIN precedence_build b
  ON p.k = b.k;
----
analyzed_plan	<REGEX>:.*Dynamic Filters:.*IN PRF\(k\).*

query II
EXPLAIN ANALYZE
SELECT count(*)
FROM precedence_probe p
JOIN precedence_build b
  ON p.k = b.k;
----
analyzed_plan	<!REGEX>:.*Dynamic Filters:.*IN PHJ\(k\).*

query II
EXPLAIN ANALYZE
SELECT count(*)
FROM precedence_probe p
JOIN precedence_build b
  ON p.k = b.k;
----
analyzed_plan	<!REGEX>:.*Dynamic Filters:.*k >= 0.*

statement ok
CREATE OR REPLACE TABLE precedence_probe_huge AS
SELECT i::HUGEINT AS k
FROM range(0, 100000) t(i);

statement ok
CREATE OR REPLACE TABLE precedence_build_huge AS
SELECT i::HUGEINT AS k, 'v' || i::VARCHAR AS payload
FROM range(0, 30000) t(i);

query II
EXPLAIN ANALYZE
SELECT count(*)
FROM precedence_probe_huge p
JOIN precedence_build_huge b
  ON p.k = b.k;
----
analyzed_plan	<REGEX>:.*Dynamic Filters:.*IN PHJ\(k\).*

query II
EXPLAIN ANALYZE
