# name: test/sql/storage/wal/wal_revert_commit.test
# description: A reverted commit preserves earlier WAL commits and allows later commits to recover
# group: [wal]

require skip_reload

load {TEST_DIR}/wal_revert_commit.db

statement ok
PRAGMA disable_checkpoint_on_shutdown

statement ok
SET GLOBAL debug_skip_checkpoint_on_commit = true

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, value VARCHAR)

statement ok
INSERT INTO t VALUES (1, 'baseline'), (2, 'original')

statement ok
CREATE TABLE dropped(id INTEGER)

statement ok
INSERT INTO dropped VALUES (10)

statement ok
CHECKPOINT

# Commit A must remain in the WAL when commit B is reverted.
statement ok
BEGIN

statement ok
UPDATE t SET value = 'commit A' WHERE id = 1

statement ok
INSERT INTO t VALUES (3, 'commit A')

statement ok
COMMIT

statement ok
SET VARIABLE committed_wal_size = (SELECT size FROM read_blob('{TEST_DIR}/wal_revert_commit.db.wal'))

statement ok
BEGIN

statement ok
UPDATE t SET value = 'failed B' WHERE id = 1

statement ok
DELETE FROM t WHERE id = 2

statement ok
INSERT INTO t VALUES (4, 'failed B')

statement ok
ALTER TABLE t RENAME TO failed_name

statement ok
CREATE TABLE failed_table(id INTEGER)

statement ok
INSERT INTO failed_table VALUES (20)

statement ok
DROP TABLE dropped

statement ok
SET GLOBAL debug_force_commit_failure = true

statement error
COMMIT
----
Forced commit failure

statement ok
SET GLOBAL debug_force_commit_failure = false

# Reversion must truncate only B's WAL records.
query I
SELECT size = getvariable('committed_wal_size') FROM read_blob('{TEST_DIR}/wal_revert_commit.db.wal')
----
true

query IT
SELECT * FROM t ORDER BY id
----
1	commit A
2	original
3	commit A

query I
SELECT * FROM dropped
----
10

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name IN ('failed_name', 'failed_table')
----
0

# Commit C reuses the inserted key and catalog name from B.
statement ok
BEGIN

statement ok
INSERT INTO t VALUES (4, 'commit C')

statement ok
CREATE TABLE failed_table(id INTEGER)

statement ok
INSERT INTO failed_table VALUES (30)

statement ok
COMMIT

# The earlier and later commits must be recovered from the WAL, without a checkpoint.
query I
SELECT count(*) FROM glob('{TEST_DIR}/wal_revert_commit.db.wal')
----
1

restart

query IT
SELECT * FROM t ORDER BY id
----
1	commit A
2	original
3	commit A
4	commit C

query I
SELECT * FROM dropped
----
10

query I
SELECT * FROM failed_table
----
30

query I
SELECT count(*) FROM duckdb_tables() WHERE table_name = 'failed_name'
----
0

# Constraints and writes still work after replay.
statement error
INSERT INTO t VALUES (2, 'duplicate')
----
Duplicate key

statement ok
INSERT INTO t VALUES (5, 'after replay')

query IT
SELECT * FROM t ORDER BY id
----
1	commit A
2	original
3	commit A
4	commit C
5	after replay
