# name: benchmark/micro/pushdown/prefix_range_filter_fallback.benchmark
# description: Prefix range filter fallback to Bloom on dispersed integer keys
# group: [pushdown]

name Prefix Range Filter Bloom Fallback
group micro
subgroup pushdown

cache prefix_range_filter_fallback_v2.duckdb

load
CREATE TABLE prf_fallback_build AS SELECT (i * 1000000000)::BIGINT AS k, 0::INTEGER AS g FROM range(4000000) t(i); CREATE TABLE prf_fallback_probe AS SELECT (i * 500000000)::BIGINT AS k, 0::INTEGER AS g FROM range(8000000) t(i);

init
SET dynamic_or_filter_threshold=0;

run
SELECT count(*) FROM prf_fallback_probe p JOIN prf_fallback_build b ON p.k = b.k AND p.g >= b.g;
